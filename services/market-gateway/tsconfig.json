{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node"],
    "baseUrl": "../..",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../lib/market/**/*.ts",
    "../../lib/intelligence/**/*.ts",
    "../../lib/risk/**/*.ts",
    "../../lib/execution/**/*.ts"
  ],
  "exclude": [
    "dist",
    "../../node_modules",
    "../../.next"
  ]
}